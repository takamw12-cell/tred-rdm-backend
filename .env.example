# ===== AeroStudy AI — variables d'environnement =====
# Copie ce fichier en `.env` et remplis les valeurs.

NODE_ENV=production
PORT=4200

# --- Base de données (Turso, gratuit : https://turso.tech) ---
DATABASE_URL=libsql://TON-DB.turso.io
DATABASE_AUTH_TOKEN=

# --- IA (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY="sk-ant-placeholder"

# --- Auth ---
# Génère un secret : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de ton app (ex. https://aerostudy.up.railway.app)
WEBSITE_URL=http://localhost:4200
# Origines supplémentaires autorisées pour la connexion (séparées par des virgules),
# par ex. un domaine personnalisé ou l'app de bureau. Le site (WEBSITE_URL) et
# l'app mobile (tred://) sont déjà inclus. Ne JAMAIS mettre "*".
TRUSTED_ORIGINS=

# --- Google OAuth (OPTIONNEL — laisse vide pour email/mot de passe seul) ---
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mets "true" pour afficher le bouton Google sur la page de connexion
VITE_AUTH_GOOGLE=false

# --- Apple OAuth (OPTIONNEL — nécessite le Apple Developer Program, 99 €/an) ---
# https://developer.apple.com → Certificates, IDs & Profiles → Services ID
# APPLE_CLIENT_ID = ton Services ID (ex. com.aerostudy.web)
# APPLE_CLIENT_SECRET = le JWT signé généré avec ta clé .p8 (voir guide)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
VITE_AUTH_APPLE=false

# --- Stockage S3 des PDF (Cloudflare R2 gratuit 10 Go, ou Tigris) ---
S3_ENDPOINT=
S3_BUCKET=aerostudy
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Recherche de vidéos YouTube (OPTIONNEL mais recommandé) ---
# https://console.cloud.google.com → créer un projet → "APIs & Services"
#   1. Library → activer "YouTube Data API v3"
#   2. Credentials → Create credentials → API key
#   3. Restreindre la clé : "API restrictions" → YouTube Data API v3
# Sans cette clé, le bouton « Video dazu finden » affiche un message explicite.
YOUTUBE_API_KEY=
# Quota Google par défaut : 10 000 unités/jour, une recherche coûte 100 unités
# (~100 recherches/jour). On s'arrête volontairement un peu avant la limite.
YOUTUBE_DAILY_BUDGET=9000

# --- Zugang / Accès ---
# Inscription OUVERTE (bêta ouverte, plus de code d'invitation).
# E-mail de bienvenue + vérification : actif dès que RESEND_API_KEY est posée.
# Sans elle, l'inscription marche aussi, mais SANS vérification d'adresse.
RESEND_API_KEY=
# Domaine vérifié chez Resend, sinon l'envoi est refusé.
MAIL_FROM="TRED <noreply@ton-domaine.de>"
# Comptes qui deviennent administrateurs à leur prochaine connexion.
# Séparés par des virgules. Mets TON email ici.
ADMIN_EMAILS=

# --- Digitaler Hörsaal : Figma + Professeur virtuel (PAS ENCORE ACTIVÉ) ---
# Voir GUIDE_FOUNDER.md. Aucune de ces variables n'est lue par l'app pour l'instant.
#
# Figma — Personal Access Token (Figma → Settings → Security → Personal access tokens,
# scopes en lecture seule). Utilisé par le serveur MCP déclaré dans .mcp.json.
# ⚠️ Claude Code ne lit PAS ce fichier .env : exporte aussi la variable dans ton
# terminal avant de lancer `claude` (voir GUIDE_FOUNDER.md, Étape C).
FIGMA_PERSONAL_ACCESS_TOKEN=
# Lien "Copy link to selection" de la frame VirtualClassroom (contient ?node-id=)
FIGMA_FILE_URL=
#
# Avatar temps réel — HeyGen LiveAvatar (console : https://app.liveavatar.com)
# C'est la clé de la console LiveAvatar, PAS celle de heygen.com (elles sont distinctes).
# ⚠️ Secret serveur uniquement : JAMAIS de préfixe VITE_ sur les clés.
AVATAR_PROVIDER=liveavatar
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
#
# Voix premium (OPTIONNEL) — ElevenLabs (https://elevenlabs.io → Developers → API Keys)
# Seulement si on veut une voix différente de celle fournie par l'avatar.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Modèle TTS (défaut eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=
#
# Transport temps réel — LiveKit Cloud (https://cloud.livekit.io → Settings → API Keys)
# Sans ces 3 valeurs, /api/livekit/token répond 503 et rien ne change dans l'app.
LIVEKIT_URL=wss://TON-PROJET.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
#
# Stockage des médias (vidéos HeyGen, exports Figma) — bucket Cloudflare R2 DÉDIÉ.
# OPTIONNEL : si vide, on réutilise le bucket S3_* ci-dessus (préfixe media/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
#
# Estimation des coûts (lib/avatar-cost.ts) — en dollars, réglables.
# 0.05 $/s = tarif HeyGen « Avatar Realtime » à l'usage. Avec LiveAvatar Lite
# (~0.10 $/min), mets plutôt 0.0017.
AVATAR_PRICE_USD_PER_SEC=0.05
TTS_PRICE_USD_PER_1K_CHARS=0.10
#
# OCR des formules — Mathpix Convert API (https://console.mathpix.com → API Keys)
# 19,99 $ d'activation une fois, puis ~0,002 $/image. Serveur uniquement.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
#
# Tableau blanc libre — tldraw (licence obligatoire en production : https://tldraw.dev/pricing)
# Sans clé : fonctionne seulement en développement.
VITE_TLDRAW_LICENSE_KEY=
#
# Erreurs front — Sentry (https://sentry.io → Project → Settings → Client Keys (DSN))
# Le DSN n'est pas un secret (il est public dans le navigateur), d'où le préfixe VITE_.
VITE_SENTRY_DSN=
#
# Analytics produit — PostHog EU (https://eu.posthog.com → Project settings → Project API key)
# Clé publique (phc_...). La capture reste désactivée tant que l'utilisateur n'a pas consenti.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Dashboard /admin/analytics : lecture des chiffres PostHog côté SERVEUR.
# Clé personnelle (PostHog → Settings → Personal API keys), scope « query:read ».
# Jamais préfixée VITE_ : elle ne doit pas partir dans le navigateur.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
#
# Génération d'images et de vidéos — Replicate (https://replicate.com/account/api-tokens)
# Sans token : l'outil generiere_bild_oder_video n'existe pas pour le tuteur.
# ⚠️ Claude Code (MCP replicate, .mcp.json) lit aussi ce token dans ton TERMINAL.
REPLICATE_API_TOKEN=
# Modèles (optionnel) — défauts : Flux Schnell (image), Wan 2.2 fast 480p (vidéo ~5 s)
REPLICATE_IMAGE_MODEL=
REPLICATE_VIDEO_MODEL=
# Limites par utilisateur et par jour (UTC)
MEDIA_VIDEO_PER_DAY=2
MEDIA_IMAGE_PER_DAY=20
# Estimation des coûts (dollars) pour les logs
MEDIA_IMAGE_PRICE_USD=0.003
MEDIA_VIDEO_PRICE_USD_PER_SEC=0.10
#
# Interrupteur côté front : false = placeholder gris, l'app reste inchangée
VITE_AVATAR_ENABLED=false
