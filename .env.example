# ===== AeroStudy AI — variables d'environnement =====
# Copie ce fichier en `.env` et remplis les valeurs.

NODE_ENV=production
PORT=4200

# --- Base de données (Turso, gratuit : https://turso.tech) ---
DATABASE_URL=libsql://TON-DB.turso.io
DATABASE_AUTH_TOKEN=

# --- IA (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Auth ---
# Génère un secret : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de ton app (ex. https://aerostudy.up.railway.app)
WEBSITE_URL=http://localhost:4200

# --- Google OAuth (OPTIONNEL — laisse vide pour email/mot de passe seul) ---
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mets "true" pour afficher le bouton Google sur la page de connexion
VITE_AUTH_GOOGLE=false

# --- Apple OAuth (OPTIONNEL — nécessite le Apple Developer Program, 99 €/an) ---
# https://developer.apple.com → Certificates, IDs & Profiles → Services ID
# APPLE_CLIENT_ID = ton Services ID (ex. com.aerostudy.web)
# APPLE_CLIENT_SECRET = le JWT signé généré avec ta clé .p8 (voir guide)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
VITE_AUTH_APPLE=false

# --- Stockage S3 des PDF (Cloudflare R2 gratuit 10 Go, ou Tigris) ---
S3_ENDPOINT=
S3_BUCKET=aerostudy
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Recherche de vidéos YouTube (OPTIONNEL mais recommandé) ---
# https://console.cloud.google.com → créer un projet → "APIs & Services"
#   1. Library → activer "YouTube Data API v3"
#   2. Credentials → Create credentials → API key
#   3. Restreindre la clé : "API restrictions" → YouTube Data API v3
# Sans cette clé, le bouton « Video dazu finden » affiche un message explicite.
YOUTUBE_API_KEY=
# Quota Google par défaut : 10 000 unités/jour, une recherche coûte 100 unités
# (~100 recherches/jour). On s'arrête volontairement un peu avant la limite.
YOUTUBE_DAILY_BUDGET=9000

# --- Zugang / Accès (verrouillage) ---
# false (ou absent) = inscription fermée, code d'invitation obligatoire.
# Passe à true seulement quand tu veux rouvrir au public.
ALLOW_PUBLIC_SIGNUP=false
# Comptes qui deviennent administrateurs à leur prochaine connexion.
# Séparés par des virgules. Mets TON email ici.
ADMIN_EMAILS=
