# ===== TRED — variables d'environnement =====
# Copie ce fichier en `.env` et remplis les valeurs.

NODE_ENV=production
PORT=4200

# --- Base de données (Turso, gratuit : https://turso.tech) ---
DATABASE_URL=libsql://TON-DB.turso.io
DATABASE_AUTH_TOKEN=

# --- IA (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY="sk-ant-placeholder"
# Modèles d'IA (facultatif — défauts : Sonnet 4.6 et Haiku 4.5). Format
# « fournisseur/modèle ». Voir MAINTENANCE.md, action 1.
# PRIMARY_AI_MODEL="anthropic/claude-sonnet-4.6"
# FAST_AI_MODEL="anthropic/claude-haiku-4.5"
# Seulement pour un modèle hors Anthropic (OpenAI, Google…) : Vercel AI Gateway.
# AI_GATEWAY_API_KEY=""

# --- Auth ---
# Génère un secret : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de ton app (ex. https://aerostudy.up.railway.app)
WEBSITE_URL=http://localhost:4200
# Origines supplémentaires autorisées pour la connexion (séparées par des virgules),
# par ex. un domaine personnalisé ou l'app de bureau. Le site (WEBSITE_URL) et
# l'app mobile (tred://) sont déjà inclus. Ne JAMAIS mettre "*".
TRUSTED_ORIGINS=

# --- Google OAuth (OPTIONNEL — laisse vide pour email/mot de passe seul) ---
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mets "true" pour afficher le bouton Google sur la page de connexion
VITE_AUTH_GOOGLE=false

# --- Apple OAuth (OPTIONNEL — nécessite le Apple Developer Program, 99 €/an) ---
# https://developer.apple.com → Certificates, IDs & Profiles → Services ID
# APPLE_CLIENT_ID = ton Services ID (ex. com.aerostudy.web)
# APPLE_CLIENT_SECRET = le JWT signé généré avec ta clé .p8 (voir guide)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
VITE_AUTH_APPLE=false

# --- Stockage S3 des PDF (Cloudflare R2 gratuit 10 Go, ou Tigris) ---
S3_ENDPOINT=
S3_BUCKET=aerostudy
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- File de travaux : Redis + worker (import et vidéo en arrière-plan) ---
# Sans REDIS_URL, rien ne change : l'import reste traité dans la requête.
# Railway : « + New » → Database → Redis, puis sur le service web ET le service
# worker : REDIS_URL = ${{Redis.REDIS_URL}}  (voir GUIDE_FOUNDER.md).
REDIS_URL=
# Réglages du service worker (facultatifs) : imports traités en même temps
# par réplique.
WORKER_IMPORT_CONCURRENCY=2
# Vidéos « Als Video erklären » préparées en même temps par réplique.
WORKER_VIDEO_CONCURRENCY=3

# --- Sécurité et limites (toutes facultatives : valeurs par défaut ci-dessous) ---
# Limites par COMPTE (en plus des limites de rafale par session).
IMPORT_RATE_PER_HOUR=10
VIDEO_RATE_PER_DAY=5
# Content-Security-Policy. Vide ou « false » : la politique complète est en
# observation (Report-Only, journal « [csp] ») et seul le socle est appliqué.
# « true » : elle devient bloquante. À ne passer à true qu'après quelques jours
# sans ligne « [csp] » dans les journaux (GUIDE_FOUNDER.md).
CSP_ENFORCE=

# --- Recherche de vidéos YouTube (OPTIONNEL mais recommandé) ---
# https://console.cloud.google.com → créer un projet → "APIs & Services"
#   1. Library → activer "YouTube Data API v3"
#   2. Credentials → Create credentials → API key
#   3. Restreindre la clé : "API restrictions" → YouTube Data API v3
# Sans cette clé, le bouton « Video dazu finden » affiche un message explicite.
YOUTUBE_API_KEY=
# Quota Google par défaut : 10 000 unités/jour, une recherche coûte 100 unités
# (~100 recherches/jour). On s'arrête volontairement un peu avant la limite.
YOUTUBE_DAILY_BUDGET=9000

# --- Recherche web du tuteur (OPTIONNEL) ---
# Sans clé, l'outil « recherche_connaissances_externes » interroge seulement
# Wikipedia (gratuit, sans clé). Avec la clé, il ajoute une recherche web.
# https://app.tavily.com → créer un compte → API Keys. Offre gratuite
# « Researcher » : 1 000 crédits/mois, 1 crédit par recherche (vérifié le 07/11/2026).
TAVILY_API_KEY=

# --- Zugang / Accès ---
# Inscription OUVERTE (bêta ouverte, plus de code d'invitation).
# E-mail de bienvenue + vérification : actif dès que RESEND_API_KEY est posée.
# Sans elle, l'inscription marche aussi, mais SANS vérification d'adresse.
RESEND_API_KEY=
# Domaine vérifié chez Resend, sinon l'envoi est refusé.
MAIL_FROM="TRED <noreply@ton-domaine.de>"
# L'administration (/admin et /api/admin/*) : UNIQUEMENT ces adresses, séparées
# par des virgules. Mets TON e-mail ici, exactement celui de ton compte TRED.
# Double protection côté serveur : l'e-mail doit être dans cette liste ET le
# compte doit avoir le rôle admin (attribué à ta prochaine connexion).
# Vide ou mal écrite : PERSONNE n'accède à l'administration.
# Sur Railway : Dashboard → ton service → Variables.
ADMIN_EMAILS=

# --- Digitaler Hörsaal : Figma + Professeur virtuel (PAS ENCORE ACTIVÉ) ---
# Voir GUIDE_FOUNDER.md. Aucune de ces variables n'est lue par l'app pour l'instant.
#
# Figma — Personal Access Token (Figma → Settings → Security → Personal access tokens,
# scopes en lecture seule). Utilisé par le serveur MCP déclaré dans .mcp.json.
# ⚠️ Claude Code ne lit PAS ce fichier .env : exporte aussi la variable dans ton
# terminal avant de lancer `claude` (voir GUIDE_FOUNDER.md, Étape C).
FIGMA_PERSONAL_ACCESS_TOKEN=
# Lien "Copy link to selection" de la frame VirtualClassroom (contient ?node-id=)
FIGMA_FILE_URL=
#
# Avatar temps réel — HeyGen LiveAvatar (console : https://app.liveavatar.com)
# C'est la clé de la console LiveAvatar, PAS celle de heygen.com (elles sont distinctes).
# ⚠️ Secret serveur uniquement : JAMAIS de préfixe VITE_ sur les clés.
AVATAR_PROVIDER=liveavatar
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
#
# Voix premium (OPTIONNEL) — ElevenLabs (https://elevenlabs.io → Developers → API Keys)
# Seulement si on veut une voix différente de celle fournie par l'avatar.
ELEVENLABS_API_KEY=
# Une voix par professeur. VIDE = voix par défaut déjà choisie dans le code
# (Kenta : Liam, Ren : George, Aiko : Alice, Haruto : Brian). Pour changer :
# coller le « Voice ID » d'une voix de la Voice Library ElevenLabs.
ELEVENLABS_VOICE_KENTA=
ELEVENLABS_VOICE_REN=
ELEVENLABS_VOICE_AIKO=
ELEVENLABS_VOICE_HARUTO=
# Plafond par étudiant et par jour, en caractères (défaut 20000 ≈ 15 réponses lues).
ELEVENLABS_DAILY_CHARS=20000
# Modèle TTS (défaut eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=
# « Als Video erklären » (vidéo explicative sur mesure). Aucune nouvelle clé :
# la fonction utilise ANTHROPIC_API_KEY, ELEVENLABS_API_KEY et le bucket des
# médias (S3_* ou R2_*). Sans l'une d'elles : 503 not_configured, bouton inchangé.
# Modèle de voix de la vidéo (défaut : ELEVENLABS_MODEL_ID, sinon eleven_multilingual_v2)
ELEVENLABS_VIDEO_MODEL_ID=
# Optionnel : imposer une voix native par langue (Voice ID de https://elevenlabs.io/app/voice-library).
# Sans cela, la voix du professeur choisi parle la langue de l'étudiant.
ELEVENLABS_VIDEO_VOICE_FR=
ELEVENLABS_VIDEO_VOICE_ES=
#
# Transport temps réel — LiveKit Cloud (https://cloud.livekit.io → Settings → API Keys)
# Sans ces 3 valeurs, /api/livekit/token répond 503 et rien ne change dans l'app.
LIVEKIT_URL=wss://TON-PROJET.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
#
# Stockage des médias (vidéos HeyGen, exports Figma) — bucket Cloudflare R2 DÉDIÉ.
# OPTIONNEL : si vide, on réutilise le bucket S3_* ci-dessus (préfixe media/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
#
# Estimation des coûts (lib/avatar-cost.ts) — en dollars, réglables.
# 0.05 $/s = tarif HeyGen « Avatar Realtime » à l'usage. Avec LiveAvatar Lite
# (~0.10 $/min), mets plutôt 0.0017.
AVATAR_PRICE_USD_PER_SEC=0.05
TTS_PRICE_USD_PER_1K_CHARS=0.10
#
# OCR des formules — Mathpix Convert API (https://console.mathpix.com → API Keys)
# 19,99 $ d'activation une fois, puis ~0,002 $/image. Serveur uniquement.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
#
# Tableau blanc libre — tldraw (licence obligatoire en production : https://tldraw.dev/pricing)
# Sans clé : fonctionne seulement en développement.
VITE_TLDRAW_LICENSE_KEY=
#
# Erreurs front — Sentry (https://sentry.io → Project → Settings → Client Keys (DSN))
# Le DSN n'est pas un secret (il est public dans le navigateur), d'où le préfixe VITE_.
VITE_SENTRY_DSN=
#
# Analytics produit — PostHog EU (https://eu.posthog.com → Project settings → Project API key)
# Clé publique (phc_...). La capture reste désactivée tant que l'utilisateur n'a pas consenti.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Dashboard /admin/analytics : lecture des chiffres PostHog côté SERVEUR.
# Clé personnelle (PostHog → Settings → Personal API keys), scope « query:read ».
# Jamais préfixée VITE_ : elle ne doit pas partir dans le navigateur.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
#
# Génération d'images et de vidéos — Replicate (https://replicate.com/account/api-tokens)
# Sans token : l'outil generiere_bild_oder_video n'existe pas pour le tuteur.
# ⚠️ Claude Code (MCP replicate, .mcp.json) lit aussi ce token dans ton TERMINAL.
REPLICATE_API_TOKEN=
# Modèles (optionnel) — défauts : Flux Schnell (image), Wan 2.2 fast 480p (vidéo ~5 s)
REPLICATE_IMAGE_MODEL=
REPLICATE_VIDEO_MODEL=
# Limites par utilisateur et par jour (UTC)
MEDIA_VIDEO_PER_DAY=2
MEDIA_IMAGE_PER_DAY=20
# Estimation des coûts (dollars) pour les logs
MEDIA_IMAGE_PRICE_USD=0.003
MEDIA_VIDEO_PRICE_USD_PER_SEC=0.10
#
# Interrupteur côté front : false = placeholder gris, l'app reste inchangée
VITE_AVATAR_ENABLED=false

# --- Partner-Ressourcen (Anzeige sous le Dashboard) ---
# Tag du programme Partenaires Amazon.de (partnernet.amazon.de), ex. « tred-21 ».
# Vide = les liens restent de simples recommandations (rien n'est monétisé).
VITE_AMAZON_PARTNER_TAG=

# --- Publicité (médiation : packages/web/src/web/lib/ad-mediation.ts) ---
# Règle d'or : jamais de pub dans le Hörsaal, le Chat ou un examen en cours,
# jamais pour un abonné. Tout est vide = aucune régie chargée, l'app ne change pas
# (le Dashboard garde les ressources partenaires « maison »).
#
# Web — Google AdSense (adsense.google.com). Activer aussi « Confidentialité
# et messages → Message RGPD » : c'est la CMP certifiée qu'exige Google en UE.
# ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID=
# ID d'un bloc « In-feed » ou « Display responsive »
VITE_ADSENSE_SLOT_NATIVE=
# ID d'un bloc « Display » pour l'écran de fin de session
VITE_ADSENSE_SLOT_INTERSTITIAL=
# Web — vidéo récompensée : Google Ad Manager (admanager.google.com), bloc « Rewarded ».
# /1234567/tred_rewarded
VITE_GAM_REWARDED_AD_UNIT=
#
# Serveur — crédit contre vidéo (+1 crédit, 15 s, 3/jour). Sans ceci : 503 not_configured.
ADS_REWARDED_ENABLED=false
# Mode test : une fausse vidéo de 15 s (« Testanzeige ») pour essayer le parcours
# complet SANS régie. Front ET serveur. Ne jamais laisser à true en production.
ADS_TEST_MODE=false
VITE_ADS_TEST_MODE=false

# --- Mode bêta gratuit (décision du 12 nov. 2026) ---
# Tant que cette variable ne vaut pas « true », TRED est 100 % gratuit : aucun
# paiement ne peut démarrer, les compteurs sont illimités en pratique, l'essai
# de 14 jours ne commence pas, /pricing affiche le bandeau « Phase de Bêta ».
# À passer à true le jour du lancement officiel (App Store / Play Store).
BILLING_ENABLED=false

# --- Paiement : Stripe (dashboard.stripe.com) ---
# Grille décidée le 12 nov. 2026 (référence : packages/web/src/api/lib/plan.ts, PRICING).
# Sans ces clés : /pricing affiche la grille, mais aucun paiement ne démarre (503).
# Clé secrète : Développeurs → Clés API (sk_live_… ; sk_test_… pour essayer).
STRIPE_SECRET_KEY=
# Secret de signature du webhook : Développeurs → Webhooks → ton endpoint
# https://www.tred-tutor.de/api/subscriptions/webhook → « Secret de signature » (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Prix récurrent 14,99 EUR / mois (produit « TRED Étudiant »). price_…
STRIPE_PRICE_PRO_MONTHLY=
# Prix récurrent 59,99 EUR tous les 6 mois (même produit). price_…
STRIPE_PRICE_PRO_SEMESTER=
# Prix UNIQUE (non récurrent) 5,00 EUR, avec la métadonnée  credits = 50
# sur le PRIX (pas sur le produit). 50 crédits = 50 chats ou 5 vidéos. price_…
STRIPE_PRICE_CREDITS_SMALL=
# Paquets supplémentaires, facultatifs (même métadonnée « credits »).
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=
# Facultatif : lien de paiement Stripe pour les crédits.
STRIPE_PAYMENT_LINK_CREDITS=
# Essai côté Stripe (carte exigée). Laisser à 0 : l'essai de 14 jours est géré
# par l'app, sans carte (colonne user_access.trial_ends_at, migre-trial.mjs).
STRIPE_TRIAL_DAYS=0
