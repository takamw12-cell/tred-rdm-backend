{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.appId.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F8F8"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://aerostu-53skcll-preview-4200.runable.site/",
      "applicationId": "aerostu-53skcll",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.appId.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F8F8"
    },
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "runable-aerostu-53skcll",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
