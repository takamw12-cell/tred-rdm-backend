{
  "expo": {
    "name": "TRED",
    "slug": "tred",
    "description": "TRED ist dein KI-Tutor für das Ingenieurstudium. Lade deine Vorlesungsskripte, Übungen und Altklausuren hoch und stelle Fragen dazu — die Antworten stützen sich auf deine eigenen Unterlagen und nennen die Seite, aus der sie stammen. TRED merkt sich, was du falsch verstanden hast, und kommt im richtigen Abstand darauf zurück. Oberfläche auf Deutsch, Englisch und Französisch — geprüft wird auf Deutsch.",
    "privacy": "public",
    "version": "1.0.0",
    "scheme": "tred",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FA"
    },
    "ios": {
      "bundleIdentifier": "de.tred.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "de.tred.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F9FA"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#EAB308"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://aerostudy-production-0c66.up.railway.app",
      "applicationId": "aerostu-53skcll",
      "scheme": "tred",
      "privacyPolicyUrl": "https://aerostudy-production-0c66.up.railway.app/datenschutz",
      "termsUrl": "https://aerostudy-production-0c66.up.railway.app/agb",
      "supportEmail": "takamw12@gmail.com"
    }
  }
}
