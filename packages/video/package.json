{
  "name": "@tred/video",
  "private": true,
  "description": "Vidéos promotionnelles de TRED, rendues avec Remotion à partir des vrais composants de packages/web.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HoersaalPromo out/tred-hoersaal-15s.mp4 --scale=2 --codec=h264 --crf=18",
    "render:fr": "remotion render src/index.ts FR-Medizin-Recht out/tred-fr-medizin-recht-30s.mp4 --scale=2 --codec=h264 --crf=18",
    "render:de": "remotion render src/index.ts DE-Elektro-Informatik out/tred-de-elektro-informatik-30s.mp4 --scale=2 --codec=h264 --crf=18",
    "render:en": "remotion render src/index.ts EN-Mechanik-Aerospace out/tred-en-mechanik-aerospace-30s.mp4 --scale=2 --codec=h264 --crf=18",
    "voiceover": "node scripts/voiceover.mjs",
    "audio": "uvx --with numpy python -I scripts/audio.py",
    "circuit": "uvx --with schemdraw python -I scripts/circuit.py",
    "typecheck": "tsc -p tsconfig.json",
    "render:series": "for c in EN-1-Beyond-Engineering EN-2-Universal-Tutor EN-3-Future-of-Learning DE-1-Jura-Medizin DE-2-Wirtschaft-Technik DE-3-Alle-Faecher; do remotion render src/index.ts $c out/$c.mp4 --scale=2 --codec=h264 --crf=18; done",
    "audio:series": "uvx --with numpy python -I scripts/audio.py series"
  },
  "devDependencies": {
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/tailwind-v4": "4.0.539",
    "@tailwindcss/postcss": "4.3.3",
    "remotion": "4.0.539"
  }
}
