{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts",
    "./legal": "./src/web/data/legal.ts",
    "./ads": "./src/web/lib/ad-mediation.ts"
  },
  "scripts": {
    "build": "bun run typecheck && vite build && bun scripts/prerender.mjs",
    "prerender": "bun scripts/prerender.mjs",
    "dev": "vite",
    "start": "bun src/__server.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "cd ../.. && oxlint packages/web --deny-warnings --no-error-on-unmatched-pattern",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "test": "bun test"
  },
