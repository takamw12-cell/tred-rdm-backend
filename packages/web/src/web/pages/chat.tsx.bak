        "chat.attachFiles": "Dateien auswählen",
        "chat.attachFilesHint": "PDFs, Bilder, Textdateien",
        "chat.attachGallery": "Galerie",
        "chat.attachGalleryHint": "Fotos aus der Galerie",
        "chat.attachCamera": "Kamera",
        "chat.attachCameraHint": "Foto aufnehmen",
        "chat.removeImage": "Bild entfernen",
        "chat.removeFile": "Datei entfernen",
        "chat.calcMode": "Rechnermodus",
        "chat.calcModeHint": "Berechnungsmodus",
        "chat.calcModeOnMatlab": "Im MATLAB-Modus",
        "chat.calcModeOnPython": "Im Python-Modus",
        "chat.fileType": "Dateityp nicht unterstützt ({name})",
        "chat.fileTooLarge": "Datei zu groß ({name})",
        "chat.imageFailed": "Bild fehlgeschlagen ({name})",
        "scratchpad.title": "Notizblock",
        "scratchpad.sendToAiPrompt": "Überprüfe meine Rechnung:",
        "chat.q1": "Was ist der Unterschied zwischen Querkraft und Normalkraft?",
        "chat.q2": "Wie berechne ich das Flächenträgheitsmoment?",
        "chat.q3": "Kannst du mir die Biegeformel erklären?",
        "video.chip": "Video erklären",
        "videoSearch.chip": "YouTube suchen",
        "dashboard.allCourses": "Alle Kurse",
        "nav.menu": "Menü",
        "nav.dashboard": "Dashboard",
