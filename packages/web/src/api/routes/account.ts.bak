import { z } from "zod";
import { ORPCError } from "@orpc/server";
import { eq } from "drizzle-orm";

import { authed } from "../middleware/auth";
import { db } from "../database";
import { userAccess } from "../database/schema";
import { deleteUserData, exportUserData, PERSONAL_DATA_TABLES } from "../lib/gdpr";
import { getStripe } from "../lib/stripe";
import { getPlanRow } from "../lib/billing";

/**
 * Konto: Sprache, Auskunft, Löschung.
 *
 * Erreichbar unter /api/rpc/account.*
 */

export const LOCALES = ["de", "en", "fr", "es"] as const;
export type Locale = (typeof LOCALES)[number];

export const account = {
  /** Gespeicherte Oberflächensprache. */
  getLocale: authed.handler(async ({ context }) => {
    const rows = await db
      .select({ locale: userAccess.locale })
      .from(userAccess)
      .where(eq(userAccess.userId, context.user.id))
      .limit(1);
    return { locale: (rows[0]?.locale ?? "de") as Locale };
  }),

  /**
   * Sprache setzen. Der Client speichert sie zusätzlich lokal — der Server ist
   * nur die Quelle für alles, was OHNE Client entsteht: Push-Texte,
   * Systemnachrichten, der Ton des Tutors.
   */
  setLocale: authed
    .input(z.object({ locale: z.enum(LOCALES) }))
    .handler(async ({ input, context }) => {
      await db
        .insert(userAccess)
        .values({ userId: context.user.id, locale: input.locale, isActive: true })
        .onConflictDoUpdate({
          target: userAccess.userId,
          set: { locale: input.locale, updatedAt: new Date() },
        });
      return { locale: input.locale };
    }),

  /** DSGVO Art. 15 & 20 — Auskunft und Datenübertragbarkeit. */
  dataExport: authed.handler(async ({ context }) => {
    try {
      const data = await exportUserData(context.user.id);
      return {
        filename: `tred-daten-${context.user.id.slice(0, 8)}-${new Date()
          .toISOString()
          .slice(0, 10)}.json`,
        data,
      };
    } catch (error) {
      console.error("[dsgvo] export failed", error);
      throw new ORPCError("INTERNAL_SERVER_ERROR", {
        message: "Der Datenexport konnte nicht erstellt werden.",
      });
    }
  }),

  /** Welche Tabellen betroffen sind — für die Bestätigungsseite. */
  deletionScope: authed.handler(async () => ({ tables: [...PERSONAL_DATA_TABLES] })),

  /**
   * DSGVO Art. 17 — Recht auf Löschung. UNWIDERRUFLICH.
   *
   * Zwei Vorsichtsmaßnahmen, die kein Gesetz verlangt, aber jeder Support
   * irgendwann braucht:
   *
   *   1. Der Nutzer muss "LÖSCHEN" tippen. Ein Knopf allein wird auch aus
   *      Versehen gedrückt, und danach gibt es nichts mehr zurückzuholen.
   *   2. Ein laufendes Abo wird ZUERST bei Stripe gekündigt. Ohne das wäre das
   *      Konto weg, die monatliche Abbuchung liefe weiter — und niemand könnte
   *      sie einem Kunden zuordnen, der nicht mehr existiert.
   */
  deleteAccount: authed
    .input(z.object({ confirm: z.literal("LÖSCHEN") }))
    .handler(async ({ context }) => {
      const plan = await getPlanRow(context.user.id);

      if (plan?.subscriptionId) {
        try {
          await getStripe().subscriptions.cancel(plan.subscriptionId);
          console.log(`[dsgvo] Abo ${plan.subscriptionId} vor Löschung gekündigt`);
        } catch (error) {
          // Ein bereits gekündigtes Abo wirft ebenfalls — das ist unkritisch.
          console.error("[dsgvo] Kündigung fehlgeschlagen", error);
        }
      }

      const report = await deleteUserData(context.user.id);

      return {
        ok: report.warnings.length === 0,
        deleted: report.deleted,
        warnings: report.warnings,
        hinweis:
          "Dein Konto und alle zugehörigen Daten wurden gelöscht. " +
          "Rechnungsbelege bleiben bei Stripe gespeichert, solange die " +
          "gesetzliche Aufbewahrungsfrist (§ 147 AO, 10 Jahre) läuft — dazu " +
          "sind wir verpflichtet, ein Löschverlangen kann sie nicht aufheben.",
      };
    }),
};
